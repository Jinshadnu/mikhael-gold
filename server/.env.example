# ==============================================================================
# MIKHAEL GOLD AND DIAMONDS LLP - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5001

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# JWT Authentication Secret Key (Generate a cryptographically secure random string in production)
JWT_SECRET=mikhael_super_secure_jwt_secret_key_2026

# JWT Expiration Duration (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# CORS Allowed Origin ('*' or 'https://mikhaelgold.com')
CORS_ORIGIN=*

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Choose DB client: 'sqlite' (out of the box zero-config) or 'mysql' (production MySQL 8.0+)
DB_CLIENT=sqlite

# If DB_CLIENT=sqlite:
DB_SQLITE_PATH=mikhael.db

# If DB_CLIENT=mysql:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mikhael_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=mikhael_gold_db

